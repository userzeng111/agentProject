APP_ENV=development
APP_NAME=小说 Agent Runtime
RUNTIME_ORIGIN=http://127.0.0.1:3000
# 可填根域名或完整 /v1 基址；根域名会按协议自动补 /v1。
LLM_BASE_URL=https://your-agenturl.example
LLM_API_KEY=your_api_key_here
DEFAULT_CHAT_MODEL=glm-5.1
DEFAULT_PROTOCOL=openai
# 可选：按模型覆盖协议，例如 {"K2.6":"anthropic"}。
MODEL_PROTOCOL_OVERRIDES=
# 可选：模型上下文窗口与生成 max_tokens 配置文件；默认使用 apps/agent-runtime/data/model_capabilities.json。
MODEL_CAPABILITIES_PATH=
# 可选：Anthropic 原生接口专用基址；未设置时复用 LLM_BASE_URL。
ANTHROPIC_BASE_URL=
ANTHROPIC_VERSION=2023-06-01
PROVIDER_PROMPT_CACHE=true
# 可选：Anthropic 兼容 prompt cache 默认 5 分钟；上游支持时可设为 1h 降低掉缓存概率。
PROVIDER_PROMPT_CACHE_TTL=
AUTO_REVIEW=false
AUTO_REVIEW_AUDITOR_MODEL=MiniMax-M2.7-highspeed
AUTO_REVIEW_SYNTHESIS_MODEL=MiniMax-M2.7-highspeed
AUTO_REVIEW_MAX_WORKERS=6
DYNAMIC_AGENT_REVIEW=false
VERIFICATION_MAX_TOKENS=2400
VERIFICATION_SHORT_MAX_TOKENS=900
VERIFICATION_INCLUDE_FULL_TEXT=false
VERIFICATION_EXCERPT_CHARS_PER_CHAPTER=1600
DRAFTING_REFERENCE_MAX_CHARS=1200
DRAFTING_MEMORY_MAX_CHARS=400
DRAFTING_SUMMARY_WINDOW_SIZE=8
DRAFTING_PREVIOUS_FULLTEXT_MAX_CHARS=1200
DRAFTING_PREVIOUS_FULLTEXT_TAIL_CHARS=700
CHAPTER_GATE_RECENT_FULLTEXT_COUNT=1
CHAPTER_GATE_SUMMARY_WINDOW_SIZE=10
CHAPTER_PARALLEL_DRAFT_ENABLED=true
CHAPTER_PARALLEL_MAX_WORKERS=4
CHAPTER_PARALLEL_MIN_BATCH_SIZE=2

# 数据库配置。DATABASE_PATH 为空时使用 tasklog/data.db。
DATABASE_PATH=
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_CONNECT_TIMEOUT_SECONDS=5
SQLITE_JOURNAL_MODE=WAL
SQLITE_FOREIGN_KEYS=true
SQLITE_SYNCHRONOUS=NORMAL
DB_SQL_LOG_ENABLED=false
DB_SLOW_QUERY_MS=100

# 上传与模型诊断落盘边界。
UPLOAD_MAX_BYTES=2097152
LLM_DIAGNOSTIC_RAW_RESPONSE_ENABLED=false
LLM_DIAGNOSTIC_RAW_RESPONSE_MAX_CHARS=2000
LLM_DIAGNOSTIC_INCLUDE_REQUEST_MESSAGES=false

# 本地 LLM 耗时代理脚本示例：
# uv run --project apps/agent-runtime python apps/agent-runtime/scripts/llm_timing_proxy.py
# 仅记录 HTTP 元数据，不记录 prompt 正文与响应正文。
LLM_TIMING_PROXY_HOST=127.0.0.1
LLM_TIMING_PROXY_PORT=18080
# 必填：上游根地址或 /v1 基址，例如 https://your-agenturl.example/v1
LLM_TIMING_PROXY_UPSTREAM_BASE_URL=
LLM_TIMING_PROXY_CONNECT_TIMEOUT_SECONDS=30
LLM_TIMING_PROXY_READ_TIMEOUT_SECONDS=300
